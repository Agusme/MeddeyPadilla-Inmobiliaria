{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back": {
      "root": "back",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "npm ci",
      "buildCommand": "npm run typecheck"
    },
    "front": {
      "root": "front",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "back"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "back"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}
