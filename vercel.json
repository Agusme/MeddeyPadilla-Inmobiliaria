{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/property-upload-cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "services": {
    "back": {
      "root": "back",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "npm ci",
      "buildCommand": "npm run typecheck"
    },
    "front": {
      "root": "front",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "back",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "back"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "back"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}
